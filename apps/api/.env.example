# Local dev server port
PORT=4000

# Origin the API accepts CORS requests from (apps/web dev server)
WEB_ORIGIN=http://localhost:3000

# --- Azure AI Foundry (real integration point, NOT used by the running demo) ---
# The demo's llmClient is always the mock implementation regardless of these
# values -- see apps/api/src/llm/azureFoundryClient.ts. They're documented
# here to show exactly what a production wiring would read.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=
AZURE_AI_FOUNDRY_API_VERSION=2026-01-01-preview
USE_REAL_AZURE_LLM=false

# --- Telegram (real integration, NOT mocked) ---
# Leave blank to keep the "Send today's summary" button inert (it will
# return a clear "not configured" error). See README.md "Telegram daily
# summary" for how to create a bot with @BotFather and find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
